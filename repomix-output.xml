                                    </div>
                                    {item.completed && item.id !== "dashboard" && (
                                        <CheckCircle2 size={16} className="text-emerald-500" />
                                    )}
                                </Link>
                            </li>
                        );
                    })}
                </ul>
            </nav>
        </div>
    );
};
