                    }
                    description="AIが文書を読み込み、技術要素（課題・解決手段など）を抽出します。"
                    actionLink={`${basePath}/analysis`}
                    actionLabel={status?.hasAnalysis ? "解析結果を見る" : "解析を開始"}
                />

                {/* Step 3: アイデア */}
                <StatusCard
                    step="03"
                    title="アイデア生成"
