        environment:
            - ENV=development
        command: uvicorn main:app --host 0.0.0.0 --port 8000 --reload

    frontend: # サービス名 `frontend`
        build: ./frontend # `./frontend/Dockerfile` を使ってイメージをビルド
        ports:
            - "3000:3000" # コンテナの3000番ポート --> `http://localhost:3000` でアクセスできる
        volumes:
            - ./frontend:/app
            - /app/node_modules # ホストのパスを指定せず、コンテナ専用のボリュームにする --> ホスト側でnpm installが必要 （Anonymous Volume 訳: 匿名ボリューム）
