}

// サブコンポーネント: ステータスカード
type Status = "locked" | "active" | "ready" | "completed";

const StatusCard = ({
    step,
    title,
    icon: Icon,
    status,
    description,
    actionLink,
    actionLabel,
}: {
    step: string;
    title: string;
    icon: any;
    status: Status;
    description: string;
    actionLink: string;
    actionLabel: string;
}) => {
    const isLocked = status === "locked";
    const isCompleted = status === "completed";
    const isActive = status === "active"; // 現在進行中

    // 色設定
    let borderColor = "border-slate-200";
    let iconColor = "text-slate-400 bg-slate-100";
    let textColor = "text-slate-500";

    if (isActive || status === "ready") {
        borderColor = "border-blue-300 ring-1 ring-blue-100";
        iconColor = "text-blue-600 bg-blue-50";
        textColor = "text-slate-800";
    } else if (isCompleted) {
        borderColor = "border-emerald-200 bg-emerald-50/30";
        iconColor = "text-emerald-600 bg-emerald-100";
        textColor = "text-slate-800";
    }

    return (
        <div
            className={`relative p-5 rounded-xl border ${borderColor} flex flex-col h-full bg-white transition-all`}>
            <div className="flex justify-between items-start mb-4">
                <div className={`p-3 rounded-lg ${iconColor}`}>
                    <Icon size={24} />
                </div>
                <span className="text-xs font-bold text-slate-300">STEP {step}</span>
            </div>

            <h3 className={`font-bold mb-2 ${textColor}`}>{title}</h3>
            <p className="text-xs text-slate-500 leading-relaxed mb-4 flex-1">{description}</p>

            {isLocked ? (
                <div className="mt-auto text-xs text-slate-400 font-medium bg-slate-100 py-2 px-3 rounded text-center">
                    未到達
                </div>
            ) : (
                <Link
                    href={actionLink}
                    className={`mt-auto text-xs font-bold py-2 px-3 rounded text-center transition-colors flex items-center justify-center gap-1
            ${
                isCompleted
                    ? "text-emerald-700 bg-emerald-100 hover:bg-emerald-200"
                    : "text-white bg-blue-600 hover:bg-blue-700"
            }
          `}>
                    {actionLabel}
                    <ArrowRight size={12} />
                </Link>
            )}
        </div>
    );
};
