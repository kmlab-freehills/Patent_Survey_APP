                    icon={Lightbulb}
                    status={hasIdeas ? "completed" : hasAnalysis ? "ready" : "locked"}
                    description="技術を応用したビジネスアイデアを創出します。"
                    actionLink={`${basePath}/ideas`}
                    actionLabel={hasIdeas ? "確認する" : "生成する"}
