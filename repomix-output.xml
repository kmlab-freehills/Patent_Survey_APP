                <StatusCard
                    step="04"
                    title="対話モード"
                    icon={MessageSquare}
                    status={hasIdeas ? "ready" : "locked"}
                    description="AIアシスタントと対話して理解を深めます。"
                    actionLink={`${basePath}/chat`}
                    actionLabel="対話する"
                />
            </div>

            {/* メインアクションエリア（現在すべきこと） */}
            <div className="bg-white border border-slate-200 rounded-xl p-8 shadow-sm mt-8">
                <h2 className="text-lg font-bold text-slate-800 mb-4">Next Action</h2>

